{
  "name": "trailsnack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/validate-db.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-tier1.mjs",
    "test:e2e": "playwright test",
    "validate:db": "node scripts/validate-db.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@huggingface/transformers-structured-output": "4.3.1",
    "idb": "8.0.4",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
